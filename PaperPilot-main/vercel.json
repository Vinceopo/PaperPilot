{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "api/app/**",
      "excludeFiles": "{mobile/**,web/node_modules/**,web/dist/**,.venv/**,api/.venv/**,api/venv/**,api/data/**,api/tests/**,machinelearning/**,paperpilot-ml/**,testdata/**,docs/**,scripts/**,**/.pytest_cache/**,**/__pycache__/**,**/*.pdf,**/*.docx,**/*.apk,**/*.aab}"
    },
    "api/webhooks/paymongo.py": {
      "maxDuration": 30,
      "includeFiles": "api/app/**",
      "excludeFiles": "{mobile/**,web/node_modules/**,web/dist/**,.venv/**,api/.venv/**,api/venv/**,api/data/**,api/tests/**,machinelearning/**,paperpilot-ml/**,testdata/**,docs/**,scripts/**,**/.pytest_cache/**,**/__pycache__/**,**/*.pdf,**/*.docx,**/*.apk,**/*.aab}"
    }
  },
  "rewrites": [
    {
      "source": "/api/webhooks/(.*)",
      "destination": "/api/webhooks/paymongo"
    },
    {
      "source": "/((?!api(?:/|$)|assets(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
