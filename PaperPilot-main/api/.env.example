GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,https://paperpilotph.vercel.app

# Resend (preferred). Dev: from onboarding@resend.dev. Leave blank to fall back to SMTP / terminal log.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# Optional SMTP fallback when Resend is unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PaperPilot <noreply@localhost>
SMTP_STARTTLS=true
OTP_ECHO_IN_RESPONSE=false

# Set false to skip email OTP on register (local/dev only). Password reset always requires a code.
OTP_ENABLED=true

# OTP stored hashed in Firebase RTDB. 5 minute expiry, one-time use after verify.
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=30
OTP_RATE_WINDOW_SECONDS=3600
OTP_MAX_SENDS_PER_HOUR=5
# Forgot / change password: 30s cooldown, 10 codes per hour.
OTP_RESET_RESEND_SECONDS=30
OTP_RESET_WINDOW_SECONDS=3600
OTP_RESET_MAX_SENDS=10
OTP_MAX_ATTEMPTS=5
# Optional HMAC key for hashing codes at rest. Auto-generated in server-only RTDB state when blank.
OTP_SECRET=

# Server-only. Local path to the current service-account JSON, raw JSON, or base64(JSON).
# On Vercel set FIREBASE_CREDENTIALS to base64 of that JSON so the PEM newlines stay intact.
# Never put this value in web/.env or mobile/app.json.
FIREBASE_CREDENTIALS=
# After SEVER_ISSUE_001 cutover: paperpilot-cb289 (leave paperpilotv6 unused).
FIREBASE_DATABASE_URL=https://paperpilot-cb289-default-rtdb.asia-southeast1.firebasedatabase.app

# Compliance pipeline limits.
FREE_SCAN_LIMIT=3
PREMIUM_SCAN_LIMIT=50
PRO_SCAN_LIMIT=75
# Absolute upload ceiling (Pro = 120 MB). Plan enforcement: Free 15 / Premium 45 / Pro 120.
# Set this on Vercel (Production + Preview) so Pro files are not rejected server-side.
MAX_UPLOAD_BYTES=120000000

# Amazon S3 (server-only). Clients upload via POST /uploads/presign then PUT to the signed URL.
# Never put these keys in web/ or mobile/. When set, API stores parsed/scan/mechanics JSON as sidecars.
# Set the same four keys on the Vercel project that hosts api/ (Project Settings → Environment Variables).
# upload_url is PUT-only (do not open in a browser). public_url is for preview/download — needs bucket
# CORS (PUT/GET/HEAD) + optional public GetObject policy; see SETUP.md "S3 bucket CORS + public read".
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=paperpilot-storage

# PayMongo (server-only). Never expose these to the web client.
# Secret key: Dashboard → Developers → API Keys (sk_test_… or sk_live_…)
PAYMONGO_SECRET_KEY=
# Webhook signing secret (whsk_…): Dashboard → Developers → Webhooks → your endpoint
PAYMONGO_WEBHOOK_SECRET=
# Comma-separated methods shown on Hosted Checkout
PAYMONGO_PAYMENT_METHODS=card,gcash,paymaya,grab_pay,qrph
# Used for Checkout success_url / cancel_url
APP_PUBLIC_URL=https://paperpilotph.vercel.app

# Render ML analyze service (gateway proxies scans here; clients never call Render directly).
ML_SERVICE_URL=
ML_SERVICE_KEY=

# IMPORTANT: Point the PayMongo webhook Endpoint URL to:
#   https://paperpilotph.vercel.app/api/webhooks/paymongo
# (not the site root). Subscribe at least to checkout_session.payment.paid.
