GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,https://paperpilotph.vercel.app

# Resend (preferred). Dev: from onboarding@resend.dev. Leave blank to fall back to SMTP / terminal log.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# Optional SMTP fallback when Resend is unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PaperPilot <noreply@localhost>
SMTP_STARTTLS=true
OTP_ECHO_IN_RESPONSE=false

# Set false to skip email OTP on register / password reset (local/dev only).
OTP_ENABLED=true

# OTP stored hashed in Firebase RTDB. 5 minute expiry, one-time use after verify.
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_RATE_WINDOW_SECONDS=3600
OTP_MAX_SENDS_PER_HOUR=5
# Forgot / change password: 60s cooldown, 10 codes per 30 minutes.
OTP_RESET_RESEND_SECONDS=60
OTP_RESET_WINDOW_SECONDS=1800
OTP_RESET_MAX_SENDS=10
OTP_MAX_ATTEMPTS=5
# Optional HMAC key for hashing codes at rest. Auto-generated in server-only RTDB state when blank.
OTP_SECRET=

# Server-only. Use the repository-root JSON path (for example, ../../paperpilotv6-firebase-adminsdk-fbsvc-504e68989d.json)
# or raw JSON in a deployment secret. Never put this value in web/.env or mobile/app.json.
FIREBASE_CREDENTIALS=
FIREBASE_DATABASE_URL=https://paperpilotv6-default-rtdb.asia-southeast1.firebasedatabase.app

# Compliance pipeline limits.
FREE_SCAN_LIMIT=3
PREMIUM_SCAN_LIMIT=50
MAX_UPLOAD_BYTES=40000000

# Cloudinary (server-side download / admin). Browser uses unsigned preset via VITE_*.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=uploaded_docs

# PayMongo (server-only). Never expose these to the web client.
# Secret key: Dashboard → Developers → API Keys (sk_test_… or sk_live_…)
PAYMONGO_SECRET_KEY=
# Webhook signing secret (whsk_…): Dashboard → Developers → Webhooks → your endpoint
PAYMONGO_WEBHOOK_SECRET=
# Comma-separated methods shown on Hosted Checkout
PAYMONGO_PAYMENT_METHODS=card,gcash,paymaya,grab_pay,qrph
# Used for Checkout success_url / cancel_url
APP_PUBLIC_URL=https://paperpilotph.vercel.app

# Render ML analyze service (gateway proxies scans here; clients never call Render directly).
ML_SERVICE_URL=
ML_SERVICE_KEY=

# IMPORTANT: Point the PayMongo webhook Endpoint URL to:
#   https://paperpilotph.vercel.app/api/webhooks/paymongo
# (not the site root). Subscribe at least to checkout_session.payment.paid.
