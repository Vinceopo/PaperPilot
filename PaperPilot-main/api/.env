GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Resend (preferred for OTP email). Dev mode: from onboarding@resend.dev, to your Resend account email only.
RESEND_API_KEY=re_UGQ79zTi_KuX2wiHhVcPBnNFukhgwfNfs
RESEND_FROM=onboarding@resend.dev

# Optional SMTP fallback (unused when RESEND_API_KEY is set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
OTP_ECHO_IN_RESPONSE=false

# Set false to skip email OTP on register / password reset (local/dev only).
OTP_ENABLED=false

# OTP: hashed in Firebase RTDB (/paperpilot_auth), one-time use, 5 minute expiry
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_RATE_WINDOW_SECONDS=3600
OTP_MAX_SENDS_PER_HOUR=5
# Forgot / change password: 60s between sends, max 10 codes per 30 minutes
OTP_RESET_RESEND_SECONDS=60
OTP_RESET_WINDOW_SECONDS=1800
OTP_RESET_MAX_SENDS=10
OTP_MAX_ATTEMPTS=5
OTP_SECRET=

# Firebase (needed so OTP hashes live in RTDB under /paperpilot_auth)
FIREBASE_CREDENTIALS=../paperpilotv6-firebase-adminsdk-fbsvc-72de439d2e.json
FIREBASE_DATABASE_URL=https://paperpilotv6-default-rtdb.asia-southeast1.firebasedatabase.app

# Compliance pipeline limits
FREE_SCAN_LIMIT=99
PREMIUM_SCAN_LIMIT=50
MAX_UPLOAD_BYTES=25000000

CLOUDINARY_CLOUD_NAME=vnyrjlil
CLOUDINARY_API_KEY=767787956374125
CLOUDINARY_API_SECRET=ZxU-HAQtYwDicuvbZkmOjw9WzL4
CLOUDINARY_UPLOAD_PRESET=uploaded_docs


# PayMongo (server-only). Never expose these to the web client.
# Secret key: Dashboard → Developers → API Keys (sk_test_… or sk_live_…)
PAYMONGO_SECRET_KEY=
# Webhook signing secret (whsk_…): Dashboard → Developers → Webhooks → your endpoint
PAYMONGO_WEBHOOK_SECRET=
# Comma-separated methods shown on Hosted Checkout
PAYMONGO_PAYMENT_METHODS=card,gcash,paymaya,grab_pay,qrph
# Used for Checkout success_url / cancel_url
APP_PUBLIC_URL=https://paperpilotph.vercel.app

# Render ML analyze service (gateway proxies scans here; clients never call Render directly).
# Local ML (port 8001). For Render: https://paperpilot-ml.onrender.com
ML_SERVICE_URL=http://127.0.0.1:8001
ML_SERVICE_KEY=paperpilot-ml-service-god999
