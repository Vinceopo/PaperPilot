VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=https://paperpilot-cb289-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=paperpilot-cb289
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ── API base (browser) ──────────────────────────────────────────────────────
# Production (Vercel): leave as /api — same origin as the static site. Do NOT set
# an absolute URL here or in the Vercel dashboard (stale hosts break every /api call).
# Local Vite: /api is proxied (see vite.config.js) to VITE_API_PROXY_TARGET.
VITE_API_URL=/api

# Dev-only. Vite server.proxy target. NEVER read by the production bundle.
# Local uvicorn (npm run dev starts it): http://127.0.0.1:8000
# Optional: vercel dev on :3000 → http://127.0.0.1:3000
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Document uploads use API-issued S3 presigned URLs (POST /uploads/presign).
# Do not put AWS keys in the web client — they belong in api/.env only.
