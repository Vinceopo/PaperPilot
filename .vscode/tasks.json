{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PaperPilot: Start API + Web",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/PaperPilot-main",
        "env": {}
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "paperpilot-dev",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "\\[web\\] starting Vite|VITE v",
          "endsPattern": "Local:\\s+http://localhost:5173|ready in"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false,
        "clear": false
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
